{
  "name": "ai-cortex",
  "version": "1.0.0",
  "description": "Self-hosted long-term memory cortex for Claude, Gemini, and other LLMs with MySQL 8.4 and native MCP",
  "type": "module",
  "main": "core/api/server.js",
  "scripts": {
    "migrate": "node core/db/migrate.js",
    "seed": "node core/db/seed.js",
    "start": "node core/api/server.js",
    "dev:server": "node --watch core/api/server.js",
    "dev:client": "vite client --port 5173",
    "dev": "node scripts/dev.js",
    "mcp": "node core/mcp/index.js",
    "build": "vite build client --outDir ../dist",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js"
  },
  "keywords": [
    "second-brain",
    "notion",
    "obsidian",
    "mysql",
    "mcp",
    "claude",
    "gemini"
  ],
  "author": "Paul Jacobs",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  }
}
